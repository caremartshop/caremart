# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PAYPACK credentials for MTN MoMo & Airtel Money payments in Rwanda
# Never commit real values — set them in Vercel → Settings → Environment Variables.
PAYPACK_CLIENT_ID=""
PAYPACK_CLIENT_SECRET=""

# CLOUDINARY credentials for photo and video uploads
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# FIREBASE credentials
VITE_FIREBASE_API_KEY="AIzaSyCtoN3rm9t9ke8VezsWT3LdfZWWaFilHoU"
VITE_FIREBASE_AUTH_DOMAIN="caremart-shop.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="caremart-shop"
VITE_FIREBASE_STORAGE_BUCKET="caremart-shop.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="397788280349"
VITE_FIREBASE_APP_ID="1:397788280349:web:d1b3e42d4d8fe6cfe5b8f4"

# PAYPACK webhook secret (Paypack dashboard → Webhooks). Lets paid orders be created even if the customer closes the page.
PAYPACK_WEBHOOK_SECRET=""

# FIREBASE ADMIN service account (server only). Firebase console → Project settings → Service accounts →
# Generate new private key. Paste the whole JSON on one line, or its base64 encoding. NEVER expose to the browser.
FIREBASE_SERVICE_ACCOUNT_KEY=""
